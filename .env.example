# ==============================================================================
# ShipGuard Production Environment Configuration (.env)
# Place this in your repository root or /root/fresa-shipguard/.env on your VPS
# ==============================================================================

# Database Connection (SQLite in Docker or Oracle Autonomous / PostgreSQL)
DATABASE_URL=sqlite:////app/data/shipguard.db

# Production Secret Key for JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your_super_secret_production_key_here_change_this
JWT_EXPIRY_HOURS=24

# AI Model Integration Keys (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_API_URL=
NVIDIA_MODEL=

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed CORS Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:8000,http://YOUR_VPS_IP,https://YOUR_DOMAIN.com

# Server Port
PORT=8000
