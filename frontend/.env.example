VITE_API_BASE_URL=http://localhost:8000/api/v1
# Google OAuth Client ID for Google Identity Services
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# NVIDIA API key placeholder for client-side features (do NOT commit real keys)
# For backend LLM calls prefer putting the key in `backend/.env` or environment variables.
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
