# Backend example environment variables (do NOT store real secrets in this file)
DATABASE_URL=sqlite:///./shipguard.db
JWT_SECRET=dev-secret-change-me
# NVIDIA API key placeholder (set your real key in a local .env or environment variable)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=gpt-4o
DATABASE_URL=sqlite:///./shipguard.db
ORACLE_USER=shipguard_app
ORACLE_PASSWORD=<secret>
ORACLE_DSN=<host>:1521/<service_name>
JWT_SECRET=<random-secret>
JWT_EXPIRY_HOURS=24
MODEL_PATH=app/ml/model.joblib
CORS_ORIGINS=http://localhost:5173

# AI Rate Limiting & Quotas (protects NVIDIA & Gemini API keys from over-usage)
AI_RATE_LIMIT_PER_MINUTE=15
AI_RATE_LIMIT_PER_HOUR=200
AI_RATE_LIMIT_PER_DAY=1000
GEMINI_DAILY_QUOTA=500
NVIDIA_DAILY_QUOTA=500

